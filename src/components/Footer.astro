---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-top">
    <h2 class="display footer-title">Hear every word.<br />Feel every praise.</h2>
    <a href="#top" class="footer-back" data-magnetic aria-label="Back to top">↑</a>
  </div>

  <div class="wrap footer-bottom">
    <div class="footer-brand">
      <span class="footer-logo">A2J <span class="text-accent">Media Solutions</span></span>
      <address>
        1, By Pass Road, Karaikal, Puducherry 609602, India
      </address>
    </div>

    <ul class="footer-links">
      <li><a href="tel:+919876543210">+91 98765 43210</a></li>
      <li><a href="mailto:johngratien@gmail.com">johngratien@gmail.com</a></li>
      <li><a href="https://www.a2jmedia.com" target="_blank" rel="noopener">www.a2jmedia.com</a></li>
    </ul>

    <p class="footer-copy">© {year} A2J Media Solutions. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 8vw, 6rem);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .footer-title {
    font-size: clamp(2.4rem, 7vw, 5rem);
    color: var(--ink);
  }

  .text-accent {
    color: var(--accent);
  }

  .footer-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font-size: 1.3rem;
    flex-shrink: 0;
    transition: background 0.35s var(--ease-out), border-color 0.35s var(--ease-out);
  }

  .footer-back:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.6rem;
    padding-block: 2.4rem 2.8rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .footer-brand address {
    margin-top: 0.5rem;
    font-style: normal;
    max-width: 28ch;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a:hover {
    color: var(--accent-2);
  }

  .footer-copy {
    color: var(--ink-faint);
    align-self: flex-end;
  }
</style>
