---
const sites = [
  {
    name: 'AFT Church',
    place: 'Bangalore',
    img: '/images/aft-church-purple.webp',
    alt: 'AFT Church sanctuary in Bangalore with acoustically treated stage',
  },
  {
    name: 'Ark Studios',
    place: 'Bangalore',
    img: '/images/studio-dreamnest.webp',
    alt: 'Ark Studios recording and production suite in Bangalore',
  },
  {
    name: 'Nava Jeeva Convention Centre',
    place: 'Bangalore',
    img: '/images/njcc-auditorium.webp',
    alt: 'Nava Jeeva Convention Centre auditorium with line array system',
  },
  {
    name: 'Gems Polytechnic',
    place: 'Aurangabad, Bihar',
    img: '/images/gems-polytechnic-hall.webp',
    alt: 'Gems Polytechnic hall, Aurangabad, Bihar, fitted with acoustic panels',
  },
];

const more = [
  { img: '/images/njcc-red-seats.webp', label: 'Nava Jeeva Convention Centre', alt: 'Nava Jeeva Convention Centre seating and stage' },
  { img: '/images/panel-hall-wide1.webp', label: 'Acoustic Treatment', alt: 'Hall fitted with triangular acoustic panels' },
  { img: '/images/gems-hall-orange.webp', label: 'Sound Proofing', alt: 'Worship hall with orange acoustic wall panels' },
  { img: '/images/studio-blue-guitars.webp', label: 'Rehearsal & Capture Suite', alt: 'Studio wall with instruments and acoustic panels' },
  { img: '/images/white-hall.webp', label: 'Acoustic Treatment', alt: 'White sanctuary hall with wall-mounted acoustic panels' },
  { img: '/images/band-rehearsal.webp', label: 'Training Solutions', alt: 'Worship band rehearsing in a treated room' },
];
---

<section class="section portfolio" id="work">
  <div class="wrap">
    <div class="section-head" data-reveal="up">
      <p class="eyebrow">Selected Portfolio</p>
      <h2 class="display section-title">Proven Sanctuaries</h2>
    </div>

    <div class="grid" data-reveal-group>
      {sites.map((s, i) => (
        <a class="card" data-tilt data-reveal="up" style={`--i:${i}`} href="#connect">
          <div class="card-media">
            <img data-tilt-media src={s.img} alt={s.alt} loading="lazy" />
          </div>
          <div class="card-meta">
            <h3>{s.name}</h3>
            <span>{s.place}</span>
          </div>
        </a>
      ))}
    </div>

    <div class="more-strip" data-reveal-group>
      {more.map((m, i) => (
        <figure class="more-item" data-reveal="fade" style={`--i:${i}`}>
          <img src={m.img} alt={m.alt} loading="lazy" />
          <figcaption>{m.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .portfolio {
    border-top: 1px solid var(--line);
  }

  .section-head {
    margin-bottom: 3.2rem;
    max-width: 40rem;
  }

  .section-title {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin-top: 0.7rem;
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .card {
    position: relative;
    display: block;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--panel);
  }

  .card-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11,10,8,0) 40%, rgba(11,10,8,0.92) 100%);
  }

  .card-meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 1.6rem;
    z-index: 2;
  }

  .card-meta h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .card-meta span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }

  .more-strip {
    margin-top: 1.4rem;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }

  .more-item {
    margin: 0;
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 4px;
    overflow: hidden;
    background: var(--panel);
  }

  .more-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) brightness(0.8);
    transition: filter 0.5s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .more-item:hover img {
    filter: grayscale(0) brightness(1);
    transform: scale(1.05);
  }

  .more-item figcaption {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    right: 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .more-item:hover figcaption {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .more-strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 560px) {
    .more-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
