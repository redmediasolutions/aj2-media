---
const links = [
  { href: '#solutions', label: 'Solutions' },
  { href: '#work', label: 'Work' },
  { href: '#rigging', label: 'Rigging' },
  { href: '#hardware', label: 'Hardware' },
  { href: '#connect', label: 'Connect' },
];
---

<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a href="#top" class="nav-logo" aria-label="A2J Media Solutions — home">
      <span class="nav-logo-mark">A2J</span>
      <span class="nav-logo-sub">Media Solutions</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="tel:+919789631524" class="nav-cta btn" data-magnetic>Call John</a>

    <button class="nav-toggle" data-nav-toggle aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>

  <div class="nav-panel" data-nav-panel>
    <ul>
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
      <li><a href="tel:+919789631524">+91 97896 31524</a></li>
    </ul>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding-block: 1.4rem;
    transition: padding 0.4s var(--ease-out), background 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .nav.is-scrolled {
    padding-block: 0.85rem;
    background: rgba(11, 10, 8, 0.82);
    backdrop-filter: blur(14px);
    border-color: var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-logo {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    line-height: 1;
  }

  .nav-logo-mark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .nav-logo-sub {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
    font-weight: 600;
  }

  .nav-links ul {
    display: flex;
    gap: 2.1rem;
  }

  .nav-links a {
    position: relative;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-dim);
    padding-block: 0.3rem;
    transition: color 0.3s var(--ease-out);
  }

  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent-2);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a.is-active {
    color: var(--ink);
  }

  .nav-links a:hover::after,
  .nav-links a.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-cta {
    padding: 0.65rem 1.3rem;
    font-size: 0.82rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--ink);
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
  }

  body.nav-open .nav-toggle span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  body.nav-open .nav-toggle span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .nav-panel {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .nav-panel {
      display: block;
      position: fixed;
      inset: 0 0 auto 0;
      top: 0;
      padding: 6.5rem 1.5rem 2rem;
      background: var(--bg);
      transform: translateY(-100%);
      transition: transform 0.5s var(--ease-in-out);
      z-index: -1;
    }
    .nav-panel.is-open {
      transform: translateY(0%);
    }
    .nav-panel ul {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }
    .nav-panel a {
      font-family: var(--font-display);
      font-size: 2rem;
      text-transform: uppercase;
    }
  }
</style>
